{
    "name": "leapmentor-platform",
    "version": "1.0.0",
    "private": true,
    "description": "LeapMentor microservices monorepo (shared package + services)",
    "workspaces": [
        "shared",
        "services/*"
    ],
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "dev:identity": "npm run dev -w services/identity-service",
        "dev:catalog": "npm run dev -w services/catalog-service",
        "dev:engagement": "npm run dev -w services/engagement-service",
        "dev:payments": "npm run dev -w services/payments-service",
        "dev:communication": "npm run dev -w services/communication-service"
    }
}
